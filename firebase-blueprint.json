{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with system settings and flame game preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique identifier"
        },
        "email": {
          "type": "string",
          "description": "The user's email address"
        },
        "installedAppIds": {
          "type": "array",
          "description": "List of installed application IDs"
        },
        "settings": {
          "type": "object",
          "properties": {
            "wallpaper": {
              "type": "string"
            },
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark"
              ]
            },
            "photoURL": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "is18Verified": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "uid",
        "email"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Storage for user profiles"
    }
  }
}
