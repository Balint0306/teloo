rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 256
        && (!('installedAppIds' in data) || data.installedAppIds is list)
        && (!('settings' in data) || (
            data.settings is map
            && (!('wallpaper' in data.settings) || data.settings.wallpaper is string)
            && (!('theme' in data.settings) || data.settings.theme in ['light', 'dark'])
            && (!('photoURL' in data.settings) || data.settings.photoURL is string)
            && (!('displayName' in data.settings) || (data.settings.displayName is string && data.settings.displayName.size() <= 128))
            && (!('is18Verified' in data.settings) || data.settings.is18Verified is bool)
        ));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users can only fetch their own profile by ID
      
      allow create: if isOwner(userId) 
        && isValidUserProfile(incoming())
        && isValidId(userId)
        && incoming().uid == userId;

      allow update: if isOwner(userId)
        && isValidUserProfile(incoming())
        // Ensure immutable fields
        && incoming().uid == existing().uid
        && incoming().email == existing().email;
      
      allow delete: if false; // Profiles are not deletable via client
    }
  }
}
